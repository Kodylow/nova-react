{
  "name": "@visa/nova-react-project",
  "version": "3.1.0",
  "description": "VISA Product Design System Nova React Library",
  "scripts": {
    "api:json": "node ./bin/format-docs.mjs && npx @visa/scripts license:remove ./libs/nova-react/dist/api.json && cp ./libs/nova-react/dist/api.json ./api.json",
    "build": "pnpm -r build",
    "build:docs": "pnpm --filter ./apps/workshop run build",
    "build:lib": "pnpm --filter ./libs/nova-react run build",
    "start": "pnpm --dir apps/workshop run dev",
    "dev": "pnpm --dir apps/workshop run dev",
    "dev:packages": "pnpm -r --parallel dev",
    "dev:docs": "pnpm --filter ./apps/workshop run dev",
    "dev:lib": "pnpm --filter ./libs/nova-react run dev",
    "lint": "eslint --fix --max-warnings 0",
    "prebuild": "pnpm prebuild:lib && pnpm build:lib && pnpm test:coverage && pnpm prebuild:docs",
    "prebuild:docs": "pnpm --parallel --filter ./apps/workshop run prebuild && node ./bin/global-meta-gen.mjs",
    "prebuild:lib": "pnpm --filter ./libs/nova-react run prebuild",
    "prepare": "is-ci || husky",
    "prepush": "pnpm lint && pnpm build",
    "presecurity": "node ./bin/pre-security-scan.mjs",
    "postsecurity": "node ./bin/post-security-scan.mjs",
    "release": "standard-version",
    "test": "vitest",
    "test:startup": "node --test bin/startup.check.mjs",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage .",
    "test:workshop": "vitest run --coverage apps/workshop --config vitest.config.ts",
    "upgrade:packages": "pnpm upgrade -r",
    "license:update": "npx @visa/scripts license"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.8.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/visa/nova-react.git"
  },
  "keywords": [
    "design system",
    "JS",
    "nova",
    "react",
    "rollup",
    "typescript",
    "UI",
    "vds",
    "visa product design system",
    "visa design system",
    "visa design",
    "vite"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@babel/parser": "7.26.3",
    "@babel/traverse": "7.26.4",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jest-axe": "^3.5.9",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@visa/nova-icons-react": "4.0.0",
    "@vitest/coverage-istanbul": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "change-case": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "7.37.2",
    "glob": "^10.3.14",
    "globals": "^16.0.0",
    "husky": "^9.0.11",
    "is-ci": "^4.1.0",
    "jest-axe": "^9.0.0",
    "jsdom": "27.0.0",
    "standard-version": "^9.5.0",
    "ts-jest-mock-import-meta": "^1.3.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "3.2.4"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
