                  aria-label="record"
                  class="v-button v-button-tertiary v-button-icon v-button-subtle"
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    class="v-icon v-icon-visa v-icon-tiny v-icon-microphone"
                    focusable="false"
                    height="16"
                    viewBox="0 0 16 16"
                    width="16"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      class="v-icon-primary"
                      d="M8 0C10.2091 0 12 1.79086 12 4V5H14V7H12V8C12 9.86384 10.7252 11.43 9 11.874V14H12V16H4V14H7V11.874C5.27477 11.43 4 9.86384 4 8V7H2V5H4V4C4 1.79086 5.79086 0 8 0ZM8 2C6.89543 2 6 2.89543 6 4V8C6 9.10457 6.89543 10 8 10C9.10457 10 10 9.10457 10 8V4C10 2.89543 9.10457 2 8 2Z"
                    />
                  </svg>
                </button>
                <button
                  aria-label="files"
                  class="v-button v-button-tertiary v-button-icon v-button-subtle"
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    class="v-icon v-icon-visa v-icon-tiny v-icon-attachment"
                    focusable="false"
                    height="16"
                    viewBox="0 0 16 16"
                    width="16"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      class="v-icon-primary"
                      d="M6 0C7.65685 0 9 1.34315 9 3V12H7V3C7 2.44772 6.55228 2 6 2C5.44772 2 5 2.44771 5 3V11C5 12.6569 6.34315 14 8 14C9.65685 14 11 12.6569 11 11V4H13V11C13 13.7614 10.7614 16 8 16C5.23858 16 3 13.7614 3 11V3C3 1.34315 4.34315 0 6 0Z"
                    />
                  </svg>
                </button>
                <button
                  aria-label="send"
                  class="v-button v-button-tertiary v-button-icon v-button-subtle"
                  style="block-size: 32px; inline-size: 32px; padding: 7px;"
                  type="submit"
                >
                  <svg
                    aria-hidden="true"
                    class="v-icon v-icon-visa v-icon-tiny v-icon-send"
                    focusable="false"
                    height="16"
                    viewBox="0 0 16 16"
                    width="16"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      class="v-icon-primary"
                      d="M15.3936 7.08167V8.91956L1.39355 14.9196L0.0517578 13.6842L1.94629 8.00061L0.0517578 2.31702L1.39355 1.08167L15.3936 7.08167ZM3.7207 8.99963L2.65137 12.2047L10.1309 8.99963H3.7207ZM3.71973 6.99963H10.127L2.65137 3.79553L3.71973 6.99963Z"
                    />
                  </svg>
                </button>
              </div>
            </div>
            <span
              aria-atomic="false"
              aria-live="polite"
              class="v-input-message"
              id="full-page-chat-card-input-message"
            >
              100,000 characters remaining
            </span>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
`;

