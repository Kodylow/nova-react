                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            class="v-icon-primary"
                            d="M8 0C10.2091 0 12 1.79086 12 4V5H14V7H12V8C12 9.86384 10.7252 11.43 9 11.874V14H12V16H4V14H7V11.874C5.27477 11.43 4 9.86384 4 8V7H2V5H4V4C4 1.79086 5.79086 0 8 0ZM8 2C6.89543 2 6 2.89543 6 4V8C6 9.10457 6.89543 10 8 10C9.10457 10 10 9.10457 10 8V4C10 2.89543 9.10457 2 8 2Z"
                          />
                        </svg>
                      </button>
                      <button
                        aria-label="files"
                        class="v-button v-button-tertiary v-button-icon v-button-subtle"
                        type="button"
                      >
                        <svg
                          aria-hidden="true"
