                            d="M15.3936 7.08167V8.91956L1.39355 14.9196L0.0517578 13.6842L1.94629 8.00061L0.0517578 2.31702L1.39355 1.08167L15.3936 7.08167ZM3.7207 8.99963L2.65137 12.2047L10.1309 8.99963H3.7207ZM3.71973 6.99963H10.127L2.65137 3.79553L3.71973 6.99963Z"
                          />
                        </svg>
                      </button>
                    </div>
                  </div>
                  <span
                    aria-atomic="false"
                    aria-live="polite"
                    class="v-input-message"
