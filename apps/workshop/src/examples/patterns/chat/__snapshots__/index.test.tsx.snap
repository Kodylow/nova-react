          aria-expanded="false"
          aria-label="Open panel"
          class="v-button v-button-large v-button-icon v-icon-two-color v-panel-toggle"
        >
          <img
            role="presentation"
            src="https://www.url.com/chat-ai.svg"
          />
        </button>
      </div>
    </div>
  </div>
</div>
`;

