exports[`Chat examples > Default full page chat should render correctly 1`] = `
<div>
  <div
    class="layout-example app-container"
    id="full-page-chat"
  >
    <div
      class="layout-container"
    >
      <header
        class="v-nav v-nav-vertical full-page-nav"
        id="full-page-vertical-navigation"
        style="block-size: auto;"
      >
        <a
          class="v-link v-skip-link"
          href="#full-page-content"
        >
          Skip to content
        </a>
        <a
          aria-label="application name"
          class="v-link v-link-no-underline v-flex v-flex-col v-gap-12 v-mb-30 v-ml-20 v-mr-16 v-mt-16"
          href="https://www.visa.com"
          id="full-page-vertical-navigation-home-link"
          style="background-color: transparent;"
        >
          <div
            class="v-nav-app-name"
          >
            <p
              class="v-typography-subtitle-1"
            >
              Application name
            </p>
          </div>
        </a>
        <div
          class="v-mb-24 v-mx-24"
        >
          <div
            class="v-flex v-flex-col v-gap-4"
