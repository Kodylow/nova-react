                class="v-typography-headline-3 v-xs-container-hide"
              >
                Application name
              </p>
            </div>
          </a>
          <div
            class="v-flex v-gap-8 v-ml-8"
          >
            <button
              aria-label="search site"
              class="v-button v-button-large v-button-tertiary v-button-icon"
            >
              <svg
                aria-hidden="true"
                class="v-icon v-icon-visa v-icon-low v-icon-search"
                focusable="false"
                height="24"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  class="v-icon-secondary"
                  d="M24 22.4814L22.4814 24L15 16.5186C15.5551 16.0641 16.0641 15.5551 16.5186 15L24 22.4814ZM9 5C11.2056 5 13 6.79443 13 9H11C11 7.89697 10.103 7 9 7V5Z"
