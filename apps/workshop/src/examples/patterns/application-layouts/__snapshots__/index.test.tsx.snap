exports[`Application layout examples > Stacked horizontal application layout should render correctly 1`] = `
<div>
  <div
    class="layout layout-example layout-stacked"
  >
    <div
      class="layout-header"
    >
      <div>
        <a
          class="v-link v-skip-link"
          href="#content"
        >
          Skip to content
        </a>
        <header
          class="v-nav v-nav-horizontal v-justify-content-between"
          id="stacked-horizontal-nav"
        >
          <button
            aria-controls="stacked-horizontal-nav-mobile-menu"
            aria-expanded="false"
            aria-label="open menu"
            class="v-button v-button-large v-button-tertiary v-button-icon v-dropdown v-desktop-container-hide"
            id="stacked-horizontal-nav-mobile-menu-button"
          >
            <svg
              aria-hidden="true"
              class="v-icon v-icon-visa v-icon-low v-icon-menu"
              focusable="false"
              height="24"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                class="v-icon-primary"
                d="M23 23H1V21H23V23ZM23 13H1V11H23V13ZM23 3H1V1H23V3Z"
              />
            </svg>
          </button>
          <a
            aria-label="Visa Application Name Home"
            class="v-link v-link-no-underline v-flex v-gap-16"
            href="./application-layouts"
            id="stacked-horizontal-nav-home-link"
            style="background-color: transparent;"
          >
            <svg
              aria-hidden="true"
              class="v-logo"
              height="23"
              viewBox="0 0 71 23"
              width="71"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                clip-rule="evenodd"
