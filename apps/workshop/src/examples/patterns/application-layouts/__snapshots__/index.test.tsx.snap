                />
              </svg>
            </button>
            <button
              aria-describedby="stacked-horizontal-nav-notifications-badge"
              aria-label="notifications"
              class="v-button v-button-large v-button-tertiary v-button-icon v-mobile-container-hide"
            >
              <svg
                aria-hidden="true"
                class="v-icon v-icon-visa v-icon-low v-icon-notifications"
                focusable="false"
                height="24"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
