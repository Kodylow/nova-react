                class="v-badge v-badge-number v-typography-label-active"
                id="stacked-horizontal-nav-notifications-badge"
              >
                3
              </sup>
            </button>
            <div
              class="v-tab v-mobile-container-hide"
            >
              <button
                aria-expanded="false"
                aria-label="Alex Miller"
                class="v-avatar v-button v-button-large v-button-tertiary v-dropdown"
              >
                <svg
                  aria-hidden="true"
                  class="v-icon v-icon-visa v-icon-low v-icon-account"
                  focusable="false"
                  height="24"
                  viewBox="0 0 24 24"
                  width="24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    class="v-icon-secondary"
                    d="M12 12C17.5228 12 22 16.4772 22 22V24H20V22C20 17.5817 16.4183 14 12 14C7.58172 14 4 17.5817 4 22V24H2V22C2 16.4772 6.47715 12 12 12Z"
                  />
                  <path
                    class="v-icon-primary"
                    d="M12 0C14.7614 0 17 2.23858 17 5C17 7.76142 14.7614 10 12 10C9.23858 10 7 7.76142 7 5C7 2.23858 9.23858 0 12 0ZM12 2C10.3431 2 9 3.34315 9 5C9 6.65685 10.3431 8 12 8C13.6569 8 15 6.65685 15 5C15 3.34315 13.6569 2 12 2Z"
                  />
                </svg>
                <svg
                  aria-hidden="true"
                  class="v-icon v-icon-visa v-icon-tiny v-icon-chevron-down v-tab-suffix"
                  focusable="false"
                  height="16"
                  viewBox="0 0 16 16"
                  width="16"
