                d="M21 0C22.65 0 24 1.35 24 3V21C24 22.65 22.65 24 21 24H3C1.35 24 0 22.65 0 21V3C0 1.35 1.35 0 3 0H21ZM3 2C2.45 2 2 2.45 2 3V21C2 21.55 2.45 22 3 22H21C21.55 22 22 21.55 22 21V3C22 2.45 21.55 2 21 2H3Z"
              />
              <defs>
                <clippath>
                  <rect
                    height="24"
                    width="24"
                  />
                </clippath>
              </defs>
            </svg>
          </button>
          <button
            aria-label="Label 1"
            aria-pressed="false"
            class="v-toggle v-gap-6"
          >
            <svg
              aria-hidden="true"
              class="v-icon v-icon-visa v-icon-low v-icon-map"
              focusable="false"
              height="24"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                class="v-icon-secondary"
                d="M12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3ZM12 5C8.13401 5 5 8.13401 5 12C5 15.866 8.13401 19 12 19C15.866 19 19 15.866 19 12C19 8.13401 15.866 5 12 5Z"
              />
              <path
