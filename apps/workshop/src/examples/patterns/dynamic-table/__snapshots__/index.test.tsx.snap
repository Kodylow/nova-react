exports[`Dynamic table examples > Table with data fetch on accordion toggle should render correctly 1`] = `
<div>
  <div
    class="v-table-wrapper"
  >
    <table
      class="v-table v-accordion accordion-style-table"
      style="--v-table-data-padding-block-default: var(--v-table-data-padding-block-small); --v-table-data-block-default: var(--v-table-data-block-small);"
    >
      <caption
        class="v-screen-reader"
      >
        Multi row expandable table.
      </caption>
      <thead>
        <tr>
          <td
            class="v-td v-th compact-column"
          >
            <button
              aria-expanded="false"
              aria-label="Expand all rows"
              class="v-button v-button-small v-button-tertiary v-button-icon"
            >
              <svg
                aria-hidden="true"
                class="v-icon v-icon-visa v-icon-tiny v-icon-chevron-right v-icon-rtl v-accordion-toggle-icon v-accordion-toggle-icon-closed"
                focusable="false"
                height="16"
                viewBox="0 0 16 16"
                width="16"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  class="v-icon-primary"
                  d="M12 8.00049L5.39355 15.0005L4 13.5249L9.21387 8.00049L4 2.47607L5.39355 1.00049L12 8.00049Z"
                />
              </svg>
            </button>
          </td>
          <th
            aria-sort="ascending"
            class="v-th"
            scope="col"
          >
            <div
              class="v-align-items-center v-flex v-gap-4 v-justify-content-between"
            >
              File name
              <button
                aria-label="Sort by File name descending"
                class="v-button v-button-small v-button-tertiary v-button-icon"
              >
                <svg
                  aria-hidden="true"
                  class="v-icon v-icon-visa v-icon-tiny v-icon-sort-ascending"
                  focusable="false"
                  height="16"
                  viewBox="0 0 16 16"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    class="v-icon-primary"
                    d="M8.64062 2.53101L13.0039 6.15601L12.3652 6.92456L11.7256 7.69409L9.00195 5.4314V13.9998H7.00195V5.43042L4.27734 7.69409L3.63867 6.92456L3 6.15601L7.3623 2.53101L8.00195 2.00073L8.64062 2.53101Z"
                  />
                </svg>
              </button>
            </div>
          </th>
          <th
            class="v-th"
            scope="col"
          >
            <div
              class="v-align-items-center v-flex v-gap-4 v-justify-content-between"
            >
              Added by
              <div
                class="v-align-items-center v-flex v-flex-grow v-justify-content-between v-pl-16"
              />
            </div>
          </th>
          <th
            class="v-th"
            scope="col"
          >
            <div
              class="v-align-items-center v-flex v-gap-4 v-justify-content-between"
            >
