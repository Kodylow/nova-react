exports[`Dynamic table examples > Subtle action bar should render correctly 1`] = `
<div>
  <div
    class="v-surface v-px-16 v-py-8"
    style="--v-surface-background: var(--palette-default-transparent); --v-surface-border-size: 0px;"
  >
    <div
      class="v-align-items-center v-flex v-flex-wrap v-gap-10 v-justify-content-end"
    >
      <button
        class="v-button"
      >
        Primary action
      </button>
      <button
        aria-label="filter table - subtle action bar"
        class="v-button v-button-small v-button-tertiary v-button-icon"
      >
        <svg
          aria-hidden="true"
          class="v-icon v-icon-visa v-icon-tiny v-icon-filter-alt"
          focusable="false"
          height="16"
          viewBox="0 0 16 16"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            class="v-icon-primary"
            d="M15 0C15.5523 0 16 0.447715 16 1V3C16 3.26522 15.8946 3.51949 15.707 3.70703L10 9.41406V13C10 13.2652 9.89457 13.5195 9.70703 13.707L7.70703 15.707C7.42103 15.993 6.99086 16.0786 6.61719 15.9238C6.24359 15.769 6 15.4044 6 15V9.41406L0.585938 4H3.41406L7.70703 8.29297C7.89457 8.4805 8 8.73478 8 9C8 8.73478 8.10543 8.4805 8.29297 8.29297L14 2.58594V2H0V0H15Z"
          />
          <defs>
            <clippath>
              <rect
                height="16"
