exports[`Dynamic table examples > Toggle action bar should render correctly 1`] = `
<div>
  <div
    class="v-surface v-px-16 v-py-8"
    style="--v-surface-background: var(--palette-default-surface-2); --v-surface-border-radius: var(--size-rounded-none);"
  >
    <div
      class="v-align-items-center v-flex v-flex-wrap v-gap-10 v-justify-content-between"
    >
      <button
        aria-expanded="false"
        class="v-button v-dropdown"
      >
        Action 
        <svg
          aria-hidden="true"
          class="v-icon v-icon-visa v-icon-tiny v-icon-chevron-down"
          focusable="false"
          height="16"
          viewBox="0 0 16 16"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            class="v-icon-primary"
            d="M1 5.39404L2.47559 4.00049L8 9.21436L13.5244 4.00049L15 5.39404L8 12.0005L1 5.39404Z"
          />
        </svg>
      </button>
      <div
        class="v-align-items-center v-flex v-gap-8"
      >
        <fieldset
          class="v-toggle-container"
        >
          <button
            aria-label="Label 3"
            aria-pressed="true"
            class="v-toggle v-gap-6"
          >
            <svg
              aria-hidden="true"
              class="v-icon v-icon-visa v-icon-low v-icon-view-grid"
              focusable="false"
              height="24"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                class="v-icon-secondary"
                d="M11 20H4V13H11V20ZM20 20H13V13H20V20ZM6 18H9V15H6V18ZM15 18H18V15H15V18ZM11 11H4V4H11V11ZM20 11H13V4H20V11ZM6 9H9V6H6V9ZM15 9H18V6H15V9Z"
              />
              <path
