                d="M12 0C18.6274 0 24 5.37258 24 12C24 18.6274 18.6274 24 12 24C5.37258 24 0 18.6274 0 12C0 5.37258 5.37258 0 12 0ZM12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM14.751 14.1777L8 16L9.87402 9.81836L16 8L14.751 14.1777ZM11.3369 11.2666L10.6885 13.4062L13.1855 12.7314L13.6191 10.5889L11.3369 11.2666Z"
              />
              <defs>
                <clippath>
                  <rect
                    height="24"
                    width="24"
                  />
                </clippath>
              </defs>
            </svg>
          </button>
        </fieldset>
        <button
          aria-label="filter table - toggle action bar"
          class="v-button v-button-small v-button-tertiary v-button-icon"
        >
          <svg
            aria-hidden="true"
            class="v-icon v-icon-visa v-icon-tiny v-icon-filter-alt"
            focusable="false"
            height="16"
            viewBox="0 0 16 16"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          >
