            </clippath>
          </defs>
        </svg>
      </button>
    </div>
  </div>
</div>
`;

exports[`Dynamic table examples > Table with action bar and pagination should render correctly 1`] = `
<div>
  <div
    class="v-flex v-flex-col v-gap-16"
  >
    <fieldset
      class="v-align-self-start v-flex v-flex-col v-gap-6"
    >
      <label
        class="v-label"
        for="action-bar-select"
      >
        Action bar
      </label>
      <div
        class="v-surface v-input-container"
      >
        <select
          class="v-input"
          id="action-bar-select"
          name="action-bar-select"
        >
          <option
            hidden=""
            value=""
          />
          <option
            value="Selection-based"
          >
            Selection-based
          </option>
          <option
            value="Subtle"
          >
            Subtle
          </option>
          <option
            value="Search"
          >
            Search
          </option>
          <option
            value="Toggle"
