exports[`Dynamic table examples > Table with indeterminate circular progress should render correctly 1`] = `
<div>
  <div
    class="v-flex v-flex-col v-gap-8"
  >
    <div
      class="v-align-items-start v-flex v-gap-16"
    >
      <button
        aria-pressed="false"
        class="v-button"
      >
        Load data
      </button>
      <button
        aria-pressed="false"
        class="v-button v-button-secondary"
      >
        Reset
      </button>
    </div>
    <div
      class="v-table-wrapper"
    >
      <table
        aria-busy="false"
        class="v-table v-table-alt"
        style="--v-table-data-padding-block-default: var(--v-table-data-padding-block-small); --v-table-data-block-default: var(--v-table-data-block-small);"
      >
        <caption
          class="v-screen-reader"
        >
          Default dynamic table with indeterminate circular progress.
        </caption>
        <thead>
          <tr>
            <th
              aria-sort="ascending"
              class="v-th"
              scope="col"
            >
              <div
                class="v-align-items-center v-flex v-gap-4 v-justify-content-between"
              >
                Column A
                <button
                  aria-label="Sort by Column A descending"
                  class="v-button v-button-small v-button-tertiary v-button-icon"
                >
                  <svg
                    aria-hidden="true"
                    class="v-icon v-icon-visa v-icon-tiny v-icon-sort-ascending"
                    focusable="false"
                    height="16"
                    viewBox="0 0 16 16"
                    width="16"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      class="v-icon-primary"
                      d="M8.64062 2.53101L13.0039 6.15601L12.3652 6.92456L11.7256 7.69409L9.00195 5.4314V13.9998H7.00195V5.43042L4.27734 7.69409L3.63867 6.92456L3 6.15601L7.3623 2.53101L8.00195 2.00073L8.64062 2.53101Z"
                    />
                  </svg>
                </button>
              </div>
            </th>
            <th
              class="v-th"
              scope="col"
            >
              <div
                class="v-align-items-center v-flex v-gap-4 v-justify-content-between"
              >
                Column B
                <button
                  aria-label="Sort by Column B ascending"
                  class="v-button v-button-small v-button-tertiary v-button-icon"
                >
                  <svg
                    aria-hidden="true"
                    class="v-icon v-icon-visa v-icon-tiny v-icon-sortable"
                    focusable="false"
                    height="16"
                    viewBox="0 0 16 16"
                    width="16"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      class="v-icon-primary"
                      d="M8.67676 1.62036L13.0029 5.58813L12.3271 6.32446L11.6504 7.06177L9.00098 4.6311V11.3684L11.6504 8.93774L12.3271 9.67505L13.0029 10.4114L8.67676 14.3792L8.00098 14.9983L7.3252 14.3792L3 10.4114L3.67578 9.67505L4.35156 8.93774L7.00098 11.3684V4.6311L4.35156 7.06177L3.67578 6.32446L3 5.58813L7.3252 1.62036L8.00098 1.00122L8.67676 1.62036Z"
                    />
                  </svg>
                </button>
              </div>
            </th>
            <th
              class="v-th"
              scope="col"
            >
              <div
                class="v-align-items-center v-flex v-gap-4 v-justify-content-between"
              >
                Column C
                <button
                  aria-label="Sort by Column C ascending"
                  class="v-button v-button-small v-button-tertiary v-button-icon"
                >
                  <svg
                    aria-hidden="true"
